  <main id="main">
    <section class="hero" id="top" aria-labelledby="hero-title">
      <div class="wrap hero-inner">
        <div class="hero-copy">
          <p class="eyebrow">Offline Big Book reader &amp; study companion</p>
          <h1 id="hero-title">Principles Before Personalities <span class="h1-sub">A reader for the 1939 Big Book, made for working the book</span></h1>
          <p class="lede">A quiet, distraction-free reader for the <strong>public-domain 1939 first edition</strong> of <cite>Alcoholics Anonymous</cite>, with the page numbers read in meetings. Highlight, bookmark, leave sticky notes and search, all kept privately on your own device.</p>
          <div class="cta-row">
            <a class="btn btn-primary" href="#download">Download</a>
            <a class="btn btn-ghost" href="#features">See what it does</a>
          </div>
          <ul class="chips" aria-label="At a glance">
            <li>No account</li>
            <li>Works offline</li>
            <li>Mac · Windows · Android · iPhone</li>
          </ul>
          <p class="hero-note">Independent project. Not affiliated with or endorsed by Alcoholics Anonymous World Services, Inc.</p>
        </div>
